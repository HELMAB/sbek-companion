msgstr "%1$s ដែលមិនទាន់បញ្ចប់បានឈប់ត្រឹម %2$d%%។ សូមបន្ត ឬលុបអ្វីដែលបានបង្កើតរួច។"

#: includes/admin/tools.php:95
msgid "import"
msgstr "ការនាំចូល"

#: includes/admin/tools.php:95
